# SQLite database (local: file in prisma folder)
DATABASE_URL="file:./prisma/data.db"

# OpenAI
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4o-mini"

# Vercel Cron auth (set in Vercel dashboard; sent as Authorization: Bearer <secret>)
CRON_SECRET="generate-a-long-random-string"

# Optional: protect manual POST /api/ingest in production
INGEST_SECRET="another-random-string"
